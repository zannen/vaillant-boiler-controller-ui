{
  "name": "vaillant-boiler-ui",
  "private": true,
  "description": "Lint tools for the web UI",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint app/static",
    "lint:css": "stylelint 'app/static/**/*.css'",
    "lint:html": "htmlhint 'app/static/**/*.html'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "htmlhint": "1.9.2",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0"
  }
}
