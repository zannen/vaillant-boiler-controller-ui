[Unit]
Description=Boiler logger and web UI
After=ebusd.service network-online.target
Wants=ebusd.service
After=time-sync.target
Wants=time-sync.target

[Service]
User=INSTALLUSER
WorkingDirectory=/home/INSTALLUSER
ExecStart=/usr/bin/python3 /home/INSTALLUSER/boiler-log-ui.py /home/INSTALLUSER/boiler.csv --users /home/INSTALLUSER/boiler-users.htpasswd --roles /home/INSTALLUSER/boiler-roles
Restart=always

[Install]
WantedBy=multi-user.target
